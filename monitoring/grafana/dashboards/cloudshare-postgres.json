{
  "uid": "cloudshare-postgres",
  "title": "CloudShare / PostgreSQL",
  "tags": ["cloudshare"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "pg_up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "min(pg_up)", "legendFormat": "postgres" }]
    },
    {
      "id": 2,
      "title": "Active connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(pg_stat_activity_count)", "legendFormat": "total" },
        { "expr": "sum(pg_stat_activity_count{state=\"active\"})", "legendFormat": "active" }
      ]
    },
    {
      "id": 3,
      "title": "Database size (bytes)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 },
      "targets": [
        { "expr": "pg_database_size_bytes{datname=\"cloudshare\"}", "legendFormat": "cloudshare" }
      ]
    },
    {
      "id": 4,
      "title": "Transactions commit/rollback (per sec)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit[5m])", "legendFormat": "commit {{datname}}" },
        { "expr": "rate(pg_stat_database_xact_rollback[5m])", "legendFormat": "rollback {{datname}}" }
      ]
    }
  ]
}
