# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cloudshare
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# Cache-Aside Redis Configuration
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
REDIS_CACHE_PASSWORD=please_change_this_cache_redis_password

# Security Redis Configuration
SECURITY_REDIS_HOST=localhost
SECURITY_REDIS_PORT=6380
REDIS_SECURITY_PASSWORD=please_change_this_security_redis_password

# Rate-Limiting Redis Configuration
RATE_LIMIT_REDIS_HOST=localhost
RATE_LIMIT_REDIS_PORT=6381
REDIS_RATELIMIT_PASSWORD=please_change_this_ratelimit_redis_password

# JWT Security Configurations
# Secret must be at least 512 bits (64 characters) for HMAC-SHA512
JWT_SECRET=your_jwt_secret_key_at_least_64_characters_please_change_this_value_in_env_file
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
# Absolute lifetime (seconds) of an MFA step-up admin session, measured from the original
# MFA verification instant, regardless of how many times the step-up token rotates in between.
JWT_STEP_UP_SESSION_MAX=900

# MinIO Object Storage Configuration
MINIO_ROOT_USER=cloudshare_minio_user
MINIO_ROOT_PASSWORD=cloudshare_minio_password

# Cryptography Configurations
CRYPTO_MASTER_KEK=your_crypto_master_kek_32_bytes_please_change

# Rate Limiting Configurations (defaults shown)
RATE_LIMIT_AUTH=5
RATE_LIMIT_MFA=5
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_LINK=30
RATE_LIMIT_LINK_GLOBAL=100
RATE_LIMIT_GENERAL=100

# Password Breach Check Configurations
PASSWORD_BREACH_CHECK_ENABLED=true
PASSWORD_BREACH_CHECK_TIMEOUT_MS=3000

# ClamAV Concurrency Configurations
CLAMAV_MAX_CONCURRENT_SCANS=8
CLAMAV_CONCURRENCY_TIMEOUT_SECONDS=30

# Download Concurrency Configurations
STORAGE_MAX_CONCURRENT_DECRYPT_DOWNLOADS=20
STORAGE_DECRYPT_ACQUIRE_TIMEOUT_SECONDS=10

# Pagination Configurations
SPRING_DATA_WEB_PAGEABLE_MAX_PAGE_SIZE=100
SPRING_DATA_WEB_PAGEABLE_ONE_INDEXED_PARAMETERS=false

# Audit Partition Scheduler Configurations
SCHEDULER_AUDIT_PARTITION_CRON=0 0 4 * * ?
SCHEDULER_AUDIT_PARTITION_LOOKAHEAD_MONTHS=3
SCHEDULER_AUDIT_PARTITION_RETENTION_MONTHS=6
SCHEDULER_AUDIT_PARTITION_ARCHIVE_ENABLED=true
SCHEDULER_AUDIT_PARTITION_ARCHIVE_PATH_PREFIX=audit-archive
